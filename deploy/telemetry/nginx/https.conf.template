resolver ${TELEMETRY_RESOLVER} valid=10s ipv6=off;

upstream telemetry_receiver {
	zone telemetry_receiver 64k;
	server receiver:8787 resolve;
}

server {
	listen 8443 ssl default_server;
	server_name ${TELEMETRY_DOMAIN};
	ssl_certificate /etc/letsencrypt/live/telemetry/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/telemetry/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_session_tickets off;
	ssl_session_cache off;

	proxy_http_version 1.1;
	proxy_connect_timeout 1s;
	proxy_send_timeout 6s;
	proxy_read_timeout 6s;
	proxy_request_buffering off;
	proxy_buffering off;
	proxy_next_upstream off;
	proxy_pass_request_headers off;
	proxy_set_header Host receiver;
	proxy_set_header Connection "";
	proxy_set_header Content-Type $content_type;
	proxy_set_header Content-Length $content_length;

	location = /v1/telemetry {
		limit_except POST {
			deny all;
		}
		proxy_pass http://telemetry_receiver;
	}

	location = /health {
		limit_except GET {
			deny all;
		}
		proxy_pass http://telemetry_receiver;
	}

	location / {
		return 404;
	}
}
